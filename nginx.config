# Tanuki Framework — Nginx configuration
# Paste this block inside your server {} in the site's Nginx config

root /ruta/a/tanuki_base/public;   # ← apunta a public/, no a la raíz del proyecto
index index.php;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ~ \.php$ {
    include        fastcgi_params;
    fastcgi_pass   unix:/run/php/php8.1-fpm.sock;   # ← ajustado a tu versión real
    fastcgi_index  index.php;
    fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
}

# Deny access to sensitive files (belt-and-suspenders — .env ya está
# fuera del document root, pero esto cubre despistes de configuración)
location ~ /\.(env|git|htaccess) {
    deny all;
}