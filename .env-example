# Tanuki Framework — Environment Variables
# Copy this file as .env and adjust the values

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Tanuki App"
APP_ENV=development
# true in development (shows detailed errors), false in production
APP_DEBUG=true
# Base URL of your app (no trailing slash)
APP_URL=http://localhost
# Base locale: en | es — affects date formatting and (later) UI translations
APP_LOCALE=en # Supported: en, es

# ── Database ───────────────────────────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=localhost # change value to db if use docker
DB_PORT=3306
DB_NAME=tanuki_db
DB_USER=scholaris
DB_PASS=frater
DB_CHARSET=utf8mb4
# Only used when DB_DRIVER=sqlite — path to the .sqlite file
DB_PATH=

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=tanuki_redis
REDIS_DATABASE=0

# MongoDB (optional)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=tanuki_mongo
